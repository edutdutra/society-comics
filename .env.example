# Copie para .env.local e preencha. O .env.local é ignorado pelo git.
#
# MongoDB Atlas: pegue a string em Database > Connect > Drivers.
# Dois detalhes que costumam travar a primeira conexão:
#   1. o nome do banco (/society-comics) precisa estar no path, senão o
#      Mongoose grava no banco "test";
#   2. seu IP precisa estar liberado em Network Access.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/society-comics?retryWrites=true&w=majority

# Identifica o projeto para o site de origem durante a importação.
# Trocar pelo seu contato real antes de rodar importações grandes.
IMPORTER_USER_AGENT="society-comics-importer/0.1 (+contato: seu-email@exemplo.com)"

# Milissegundos entre requisições do importador. Não baixar disso.
IMPORTER_DELAY_MS=1000

LOG_LEVEL=info
